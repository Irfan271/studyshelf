DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production: DJANGO_DEBUG=0, configure HTTPS first.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
CLAMAV_ENABLED=0
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=20
# DJANGO_PRIVATE_MEDIA_ROOT=/srv/studyshelf-private-media
